Question (15 Marks): Implement a menu-driven Banker's algorithm to accept Allocation, Max and Available from the user, display Allocation and Max, calculate and display Need, and display Available.
C program

#include <stdio.h>

int main()
{
    int n, i, j, choice;
    int allocation[10][3], max[10][3];
    int need[10][3], available[3];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Allocation matrix (A B C):\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < 3; j++)
            scanf("%d", &allocation[i][j]);

    printf("Enter Max matrix (A B C):\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < 3; j++)
            scanf("%d", &max[i][j]);

    printf("Enter Available resources (A B C): ");
    for (j = 0; j < 3; j++)
        scanf("%d", &available[j]);

    for (i = 0; i < n; i++)
        for (j = 0; j < 3; j++)
            need[i][j] = max[i][j] - allocation[i][j];

    do {
        printf("\n1. Display Allocation and Max");
        printf("\n2. Display Need");
        printf("\n3. Display Available");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1:
            printf("\nAllocation\t\tMax\n");
            for (i = 0; i < n; i++) {
                for (j = 0; j < 3; j++)
                    printf("%d ", allocation[i][j]);
                printf("\t\t");
                for (j = 0; j < 3; j++)
                    printf("%d ", max[i][j]);
                printf("\n");
            }
            break;

        case 2:
            printf("Need Matrix:\n");
            for (i = 0; i < n; i++) {
                for (j = 0; j < 3; j++)
                    printf("%d ", need[i][j]);
                printf("\n");
            }
            break;

        case 3:
            printf("Available: ");
            for (j = 0; j < 3; j++)
                printf("%d ", available[j]);
            printf("\n");
            break;

        case 4:
            printf("Exiting...\n");
            break;

        default:
            printf("Invalid choice!\n");
        }
    } while (choice != 4);

    return 0;
}


Question (15 Marks): Write a simulation program for disk scheduling using the SCAN algorithm. Accept the total number of disk blocks, disk request string and current head position from the user. Display the order in which requests are served and the total number of head movements

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[100], n, head, i, j, size;
    int total = 0, temp;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &size);

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter disk requests:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter starting head position: ");
    scanf("%d", &head);

    /* Sort requests in ascending order */
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    printf("\nSCAN order (Direction: Left):\n");
    printf("%d", head);

    /* Service requests to the left */
    for (i = n - 1; i >= 0; i--) {
        if (a[i] < head) {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }
    }

    /* Move to the left end */
    total += head;
    head = 0;
    printf(" -> %d", head);

    /* Service requests to the right */
    for (i = 0; i < n; i++) {
        if (a[i] > head) {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }
    }

    printf("\nTotal head movements = %d\n", total);

    return 0;
}

