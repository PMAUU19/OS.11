Q.2 Write a simulation program for disk scheduling using SCAN algorithm.

[15 Marks]

Accept total Number of disk blocks, disk request string, and current head position from the user. Display the list of requests in the order in which it is served. Also display the total number of head moments.

82, 170, 43, 140, 24, 16, 190, 65

Starting Head position= 50


#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, head, i, total = 0;
    int request[100];

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid number of blocks!\n");
        return 1;
    }

    printf("Enter number of disk requests: ");
    scanf("%d", &request[0]);

    int count = request[0];

    if (count <= 0 || count > 99) {
        printf("Invalid number of requests!\n");
        return 1;
    }

    printf("Enter disk request string:\n");

    for (i = 0; i < count; i++) {
        scanf("%d", &request[i]);

        if (request[i] < 0 || request[i] >= n) {
            printf("Invalid request: block out of range!\n");
            return 1;
        }
    }

    printf("Enter current head position: ");
    scanf("%d", &head);

    if (head < 0 || head >= n) {
        printf("Invalid head position!\n");
        return 1;
    }

    printf("\nRequest Service Order:\n");
    printf("%d", head);

    for (i = 0; i < count; i++) {
        total += abs(head - request[i]);
        head = request[i];
        printf(" -> %d", head);
    }

    printf("\nTotal Head Movement = %d cylinders\n", total);

