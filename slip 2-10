Max from user

a) Accept Available

b) Display Allocation, Max

c) Find Need and display It,

d) Display Available

Consider the system with 3 resources types A, B, and C with 7, 2, 6 instances respectively consider the following snapshot:

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <string.h>

#define MAX 100

int bit[MAX], n;
int fileCount = 0;

struct File {
    char name[30];
    int blocks[MAX];
    int count;
};

struct File files[MAX];

void showBitVector()
{
    int i;

    printf("\nBit Vector (0 = Free, 1 = Allocated):\n");
    for (i = 0; i < n; i++)
        printf("%d ", bit[i]);

    printf("\n");
}

void createFile()
{
    char name[30];
    int count, i, freeCount = 0;

    printf("Enter file name: ");
    scanf("%29s", name);

    for (i = 0; i < fileCount; i++) {
        if (strcmp(files[i].name, name) == 0) {
            printf("File already exists!\n");
            return;
        }
    }

    printf("Enter number of blocks required: ");
    scanf("%d", &count);

    if (count <= 0 || count > n) {
        printf("Invalid number of blocks!\n");
        return;
    }

    for (i = 0; i < n; i++)
        if (bit[i] == 0)
            freeCount++;

    if (freeCount < count) {
        printf("Not enough free blocks!\n");
        return;
    }

    strcpy(files[fileCount].name, name);
    files[fileCount].count = 0;

    for (i = 0; i < n && files[fileCount].count < count; i++) {
        if (bit[i] == 0) {
            bit[i] = 1;
            files[fileCount].blocks[files[fileCount].count] = i;
            files[fileCount].count++;
        }
    }

    printf("File created successfully!\n");
    printf("Allocated blocks: ");

    for (i = 0; i < count; i++)
        printf("%d ", files[fileCount].blocks[i]);

    printf("\n");
    fileCount++;
}

void showDirectory()
{
    int i, j;

    printf("\nFile Name\tAllocated Blocks\n");

    for (i = 0; i < fileCount; i++) {
        printf("%s\t\t", files[i].name);

        for (j = 0; j < files[i].count; j++)
            printf("%d ", files[i].blocks[j]);

        printf("\n");
    }

    if (fileCount == 0)
        printf("Directory is empty.\n");
}

int main()
{
    int i, choice;

    printf("Enter number of disk blocks (max %d): ", MAX);
    scanf("%d", &n);

    if (n <= 0 || n > MAX) {
        printf("Invalid disk size!\n");
        return 1;
    }

    srand((unsigned int)time(NULL));

    for (i = 0; i < n; i++)
        bit[i] = rand() % 2;

    do {
        printf("\n--- Linked File Allocation Menu ---\n");
        printf("1. Show Bit Vector\n");
        printf("2. Create New File\n");
        printf("3. Show Directory\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                showBitVector();
                break;

            case 2:
                createFile();
                break;

            case 3:
                showDirectory();
                break;

            case 4:
                printf("Exiting program.\n");
                break;

            default:
                printf("Invalid choice!\n");
        }
    } while (choice != 4);

    return 0;
}

