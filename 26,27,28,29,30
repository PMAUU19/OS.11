Q.1: Preemptive Priority CPU Scheduling Simulation
Question: Write the program to simulate Preemptive Priority scheduling. The arrival time and first CPU-burst and priority for different n number of processes should be input to the algorithm. The next CPU-burst should be generated randomly.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id, at, bt1, bt2, total_bt, priority, rt, ct, tat, wt;
};

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time, First CPU Burst, and Priority for P%d: ", p[i].id);
        scanf("%d %d %d", &p[i].at, &p[i].bt1, &p[i].priority);
        p[i].bt2 = rand() % 10 + 1;
        p[i].total_bt = p[i].bt1 + p[i].bt2;
        p[i].rt = p[i].total_bt;
    }

    int completed = 0, current_time = 0;
    float total_wt = 0, total_tat = 0;

    while (completed < n) {
        int highest_priority = 9999, idx = -1;
        for (int i = 0; i < n; i++) {
            if (p[i].at <= current_time && p[i].rt > 0 && p[i].priority < highest_priority) {
                highest_priority = p[i].priority;
                idx = i;
            }
        }

        if (idx == -1) {
            current_time++;
        } else {
            p[idx].rt--;
            current_time++;
            if (p[idx].rt == 0) {
                completed++;
                p[idx].ct = current_time;
                p[idx].tat = p[idx].ct - p[idx].at;
                p[idx].wt = p[idx].tat - p[idx].total_bt;
                total_wt += p[idx].wt;
                total_tat += p[idx].tat;
            }
        }
    }

    printf("\nPID\tArrival\tBurst\tPriority\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].total_bt, p[i].priority, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}

Q.2: Demand Paging FIFO Page Replacement
Question: Write the simulation program for demand paging and show the page scheduling and total number of page faults according to the FIFO page replacement algorithm. Assume the memory of n frames. Reference String: 3, 4, 5, 6, 3, 4, 7, 3, 4, 5, 6, 7, 2, 4, 6.  
C Code Implementation:

#include <stdio.h>

int main() {
    int ref[] = {3, 4, 5, 6, 3, 4, 7, 3, 4, 5, 6, 7, 2, 4, 6};
    int n = 15;
    int frames, page_faults = 0, k = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int mem[frames];
    for (int i = 0; i < frames; i++) mem[i] = -1;

    printf("\nRef\tFrames\n");
    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (mem[j] == ref[i]) {
                found = 1;
                break;
            }
        }

        if (!found) {
            mem[k] = ref[i];
            k = (k + 1) % frames;
            page_faults++;
        }

        printf("%d\t", ref[i]);
        for (int j = 0; j < frames; j++) {
            if (mem[j] != -1) printf("%d ", mem[j]);
            else printf("- ");
        }
        if (!found) printf("(Fault)");
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", page_faults);
    return 0;
}

Q.1: Disk Scheduling Using SSTF Algorithm
Question: Write a simulation program for disk scheduling using SSTF algorithm. Accept total number of disk blocks, disk request string, and current head position from the user. Display the list of requests in the order in which it is served. Also display the total number of head movements. Request string: 30, 10, 60, 95, 120, 150, 175 | Start Head Position: 50.  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

int main() {
    int n, head;
    printf("Enter total number of requests: ");
    scanf("%d", &n);

    int req[n];
    bool visited[n];
    printf("Enter request string:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &req[i]);
        visited[i] = false;
    }

    printf("Enter current head position: ");
    scanf("%d", &head);

    int head_movement = 0;
    printf("\nServed Request Order: ");

    for (int i = 0; i < n; i++) {
        int min_dist = 9999, idx = -1;
        for (int j = 0; j < n; j++) {
            if (!visited[j]) {
                int dist = abs(req[j] - head);
                if (dist < min_dist) {
                    min_dist = dist;
                    idx = j;
                }
            }
        }

        visited[idx] = true;
        head_movement += min_dist;
        head = req[idx];
        printf("%d ", head);
    }

    printf("\nTotal Head Movements: %d\n", head_movement);
    return 0;
}


Q.2: Demand Paging LRU Page Replacement
Question: Write the simulation program to implement demand paging and show the page scheduling and total number of page faults according to the LRU (using counter method) page replacement algorithm. Assume the memory of n frames. Reference String: 3, 5, 7, 2, 5, 1, 2, 3, 1, 3, 5, 3, 1, 6, 2.  

#include <stdio.h>

int main() {
    int ref[] = {3, 5, 7, 2, 5, 1, 2, 3, 1, 3, 5, 3, 1, 6, 2};
    int n = 15;
    int frames, page_faults = 0, time = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int mem[frames], counter[frames];
    for (int i = 0; i < frames; i++) {
        mem[i] = -1;
        counter[i] = 0;
    }

    printf("\nRef\tFrames\n");
    for (int i = 0; i < n; i++) {
        time++;
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (mem[j] == ref[i]) {
                found = 1;
                counter[j] = time;
                break;
            }
        }

        if (!found) {
            int pos = -1, min = time + 1;
            for (int j = 0; j < frames; j++) {
                if (mem[j] == -1) {
                    pos = j;
                    break;
                }
                if (counter[j] < min) {
                    min = counter[j];
                    pos = j;
                }
            }
            mem[pos] = ref[i];
            counter[pos] = time;
            page_faults++;
        }

        printf("%d\t", ref[i]);
        for (int j = 0; j < frames; j++) {
            if (mem[j] != -1) printf("%d ", mem[j]);
            else printf("- ");
        }
        if (!found) printf("(Fault)");
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", page_faults);
    return 0;
}


Q.1: Disk Scheduling Using SCAN Algorithm
Question: Write a simulation program for disk scheduling using SCAN algorithm. Accept total number of disk blocks, disk request string, and current head position from the user. Display the list of requests in the order in which it is served. Also display the total number of head movements. Request string: 10, 25, 75, 90, 130, 145, 180, 55 | Starting Head Position: 80 | Direction: Left.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>

void sort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] > arr[j]) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

int main() {
    int n, head, max_limit = 199;
    printf("Enter total number of requests: ");
    scanf("%d", &n);

    int req[n + 2];
    printf("Enter request string:\n");
    for (int i = 0; i < n; i++) scanf("%d", &req[i]);

    printf("Enter current head position: ");
    scanf("%d", &head);

    req[n] = head;
    req[n + 1] = 0; // End boundary for left direction
    n += 2;
    sort(req, n);

    int head_movement = 0;
    int idx = 0;
    for (int i = 0; i < n; i++) {
        if (req[i] == head) {
            idx = i;
            break;
        }
    }

    printf("\nServed Request Order: ");
    // Moving Left first
    for (int i = idx; i >= 0; i--) {
        printf("%d ", req[i]);
        if (i > 0)
            head_movement += abs(req[i] - req[i - 1]);
    }

    // Moving Right for remaining requests
    if (idx < n - 1) {
        head_movement += abs(req[0] - req[idx + 1]);
        for (int i = idx + 1; i < n; i++) {
            printf("%d ", req[i]);
            if (i < n - 1)
                head_movement += abs(req[i] - req[i + 1]);
        }
    }

    printf("\nTotal Head Movements: %d\n", head_movement);
    return 0;
}

