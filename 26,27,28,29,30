Q.1: Array Sorting and Binary Search via execve()
Question: Implement the C program that accepts an integer array. Main function forks child process. Parent process sorts an integer array and passes the sorted array to child process through the command line arguments of execve() system call. 

parent code
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int n;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);

    // Sort array in parent using Bubble Sort
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    char *args[n + 3];
    args[0] = "./child";
    for (int i = 0; i < n; i++) {
        args[i + 1] = malloc(10);
        sprintf(args[i + 1], "%d", arr[i]);
    }
    args[n + 1] = NULL;

    pid_t pid = fork();
    if (pid == 0) {
        execve("./child", args, NULL);
        perror("Execve failed");
        exit(1);
    } else {
        wait(NULL);
    }
    return 0;
}

child program 
#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
    int n = argc - 1;
    int arr[n];
    for (int i = 0; i < n; i++) arr[i] = atoi(argv[i + 1]);

    int key;
    printf("\n[Child Program] Enter element to search using Binary Search: ");
    scanf("%d", &key);

    int low = 0, high = n - 1, found = 0;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] == key) {
            printf("Element %d found at index %d!\n", key, mid);
            found = 1;
            break;
        } else if (arr[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    if (!found) printf("Element not found in the array.\n");
    return 0;
}

Q.2: FCFS CPU Scheduling Simulation
Question: Write the program to simulate FCFS CPU scheduling. The arrival time and first CPU-burst for different n number of processes should be input to the algorithm. The next CPU-burst should be generated randomly. 

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id;
    int at; // Arrival time
    int bt1; // First CPU burst
    int bt2; // Second CPU burst (randomly generated)
    int ct, tat, wt;
};

int main() {
    int n, i;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time and First CPU Burst for Process P%d: ", p[i].id);
        scanf("%d %d", &p[i].at, &p[i].bt1);
        p[i].bt2 = rand() % 10 + 1; // Random next CPU burst between 1 and 10
    }

    // Sort by arrival time
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (p[i].at > p[j].at) {
                struct Process temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    int current_time = 0;
    float total_wt = 0, total_tat = 0;

    printf("\n--- GANTT CHART ---\n|");
    for (i = 0; i < n; i++) {
        if (current_time < p[i].at)
            current_time = p[i].at;
        current_time += p[i].bt1 + p[i].bt2;
        p[i].ct = current_time;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - (p[i].bt1 + p[i].bt2);
        
        total_wt += p[i].wt;
        total_tat += p[i].tat;

        printf(" P%d |", p[i].id);
    }
    printf("\n");

    printf("\nPID\tArrival\tBurst1\tBurst2\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].bt1, p[i].bt2, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}


Q.1: Round Robin (RR) CPU Scheduling Simulation
Question: Write the program to simulate Round Robin (RR) CPU-scheduling. The arrival time and first CPU-burst for different n number of processes should be input to the algorithm. Also give the time quantum as input. Assume the fixed IO waiting time (2 units). The next CPU-burst should be generated randomly. The output should give Gantt chart, turnaround time and waiting time for each process. Also find the average waiting time and turnaround time.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id, at, bt1, bt2, total_bt, rt, ct, tat, wt, in_io;
};

int main() {
    int n, tq;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    printf("Enter time quantum: ");
    scanf("%d", &tq);

    struct Process p[10];
    srand(time(0));

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time and First CPU Burst for P%d: ", p[i].id);
        scanf("%d %d", &p[i].at, &p[i].bt1);
        p[i].bt2 = rand() % 10 + 1;
        p[i].total_bt = p[i].bt1 + p[i].bt2;
        p[i].rt = p[i].total_bt;
        p[i].in_io = 0;
    }

    int completed = 0, current_time = 0;
    float total_wt = 0, total_tat = 0;

    printf("\n--- GANTT CHART ---\n|");
    while (completed < n) {
        int done = 1;
        for (int i = 0; i < n; i++) {
            if (p[i].at <= current_time && p[i].rt > 0) {
                done = 0;
                printf(" P%d |", p[i].id);
                if (p[i].rt > tq) {
                    current_time += tq;
                    p[i].rt -= tq;
                } else {
                    current_time += p[i].rt;
                    p[i].rt = 0;
                    completed++;
                    p[i].ct = current_time;
                    p[i].tat = p[i].ct - p[i].at;
                    p[i].wt = p[i].tat - p[i].total_bt;
                    total_wt += p[i].wt;
                    total_tat += p[i].tat;
                }
            }
        }
        if (done) current_time++;
    }
    printf("\n");

    printf("\nPID\tArrival\tTotalBurst\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].total_bt, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}


