Slip 1 — Question 1 (15 Marks)
Question: Write a simulation program for demand paging and show the page scheduling and total number of page faults according to the Optimal Page Replacement algorithm. Assume the memory of n frames.
Reference string: 8, 5, 7, 8, 5, 7, 2, 3, 7, 3, 5, 9, 4, 6, 2
Complete C program

#include <stdio.h>

int main()
{
    int pages[] = {8, 5, 7, 8, 5, 7, 2, 3,
                   7, 3, 5, 9, 4, 6, 2};

    int n = 15, frames, i, j, k;
    int pageFaults = 0, hit;
    int future, replace, farthest;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int memory[frames];

    for (i = 0; i < frames; i++)
        memory[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");

    for (i = 0; i < n; i++)
    {
        hit = 0;

        for (j = 0; j < frames; j++)
        {
            if (memory[j] == pages[i])
            {
                hit = 1;
                break;
            }
        }

        if (hit == 0)
        {
            pageFaults++;

            replace = -1;
            farthest = -1;

            for (j = 0; j < frames; j++)
            {
                if (memory[j] == -1)
                {
                    replace = j;
                    break;
                }

                future = n;

                for (k = i + 1; k < n; k++)
                {
                    if (memory[j] == pages[k])
                    {
                        future = k;
                        break;
                    }
                }

                if (future > farthest)
                {
                    farthest = future;
                    replace = j;
                }
            }

            memory[replace] = pages[i];
        }

        printf("%d\t", pages[i]);

        for (j = 0; j < frames; j++)
        {
            if (memory[j] == -1)
                printf("- ");
            else
                printf("%d ", memory[j]);
        }

        if (hit == 1)
            printf("\tHit");
        else
            printf("\tPage Fault");

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);

    return 0;
}

