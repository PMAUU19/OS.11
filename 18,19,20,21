
Q.1: Preemptive Shortest Job First (SJF) CPU Scheduling Simulation
Question: Write the program to simulate Preemptive Shortest Job First (SJF) scheduling. The arrival time and first CPU burst for different n number of processes should be input to the algorithm. The next CPU burst should be generated randomly. The output should give Gantt chart, turnaround time and waiting time for each process. Also find the average waiting time and turnaround time.  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id, at, bt1, bt2, total_bt, rt, ct, tat, wt;
};

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time and First CPU Burst for P%d: ", p[i].id);
        scanf("%d %d", &p[i].at, &p[i].bt1);
        p[i].bt2 = rand() % 10 + 1;
        p[i].total_bt = p[i].bt1 + p[i].bt2;
        p[i].rt = p[i].total_bt;
    }

    int completed = 0, current_time = 0;
    float total_wt = 0, total_tat = 0;

    while (completed < n) {
        int min_rt = 9999, idx = -1;
        for (int i = 0; i < n; i++) {
            if (p[i].at <= current_time && p[i].rt > 0 && p[i].rt < min_rt) {
                min_rt = p[i].rt;
                idx = i;
            }
        }

        if (idx == -1) {
            current_time++;
        } else {
            p[idx].rt--;
            current_time++;
            if (p[idx].rt == 0) {
                completed++;
                p[idx].ct = current_time;
                p[idx].tat = p[idx].ct - p[idx].at;
                p[idx].wt = p[idx].tat - p[idx].total_bt;
                total_wt += p[idx].wt;
                total_tat += p[idx].tat;
            }
        }
    }

    printf("\nPID\tArrival\tTotalBurst\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].total_bt, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}

Q.2: Orphan Process Illustration
Question: Write a C program to illustrate the concept of orphan process. Parent process creates a child process and terminates before child has finished its task. So child process becomes orphan process. (Use fork(), sleep(), getpid(), getppid).  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    } else if (pid == 0) {
        // Child process
        printf("Child Process created. PID: %d, Initial Parent PID: %d\n", getpid(), getppid());
        sleep(5); // Wait for parent to terminate
        printf("Child Process resumed. PID: %d, New Parent PID: %d (Adopted by init/systemd)\n", getpid(), getppid());
    } else {
        // Parent process terminates immediately
        printf("Parent Process (PID: %d) terminating...\n", getpid());
        exit(0);
    }
    return 0;
}

Q.1: Preemptive Priority CPU Scheduling Simulation
Question: Write the program to simulate Preemptive Priority scheduling. The arrival time and first CPU-burst and priority for different n number of processes should be input to the algorithm. The next CPU-burst should be generated.  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id, at, bt1, bt2, total_bt, priority, rt, ct, tat, wt;
};

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time, First CPU Burst, and Priority for P%d: ", p[i].id);
        scanf("%d %d %d", &p[i].at, &p[i].bt1, &p[i].priority);
        p[i].bt2 = rand() % 10 + 1;
        p[i].total_bt = p[i].bt1 + p[i].bt2;
        p[i].rt = p[i].total_bt;
    }

    int completed = 0, current_time = 0;
    float total_wt = 0, total_tat = 0;

    while (completed < n) {
        int highest_priority = 9999, idx = -1;
        for (int i = 0; i < n; i++) {
            if (p[i].at <= current_time && p[i].rt > 0 && p[i].priority < highest_priority) {
                highest_priority = p[i].priority;
                idx = i;
            }
        }

        if (idx == -1) {
            current_time++;
        } else {
            p[idx].rt--;
            current_time++;
            if (p[idx].rt == 0) {
                completed++;
                p[idx].ct = current_time;
                p[idx].tat = p[idx].ct - p[idx].at;
                p[idx].wt = p[idx].tat - p[idx].total_bt;
                total_wt += p[idx].wt;
                total_tat += p[idx].tat;
            }
        }
    }

    printf("\nPID\tArrival\tBurst\tPriority\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].total_bt, p[i].priority, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}

Q.2: Demonstration of nice() System Call
Question: Write a program that demonstrates the use of nice() system call. After a child process is started using fork(), assign higher priority to the child using nice() system call.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/resource.h>
#include <errno.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    } else if (pid == 0) {
        // Child process
        printf("Child Process Initial Nice Value: %d\n", getpriority(PRIO_PROCESS, 0));
        
        // Lower nice value increases process priority (negative value means higher priority, requires privileges or increments downward)
        // Using nice() to modify priority
        errno = 0;
        int ret = nice(-5); 
        if (ret == -1 && errno != 0) {
            perror("nice failed (note: increasing priority might require root privileges)");
        } else {
            printf("Child Process New Priority/Nice Value after nice(-5): %d\n", getpriority(PRIO_PROCESS, 0));
        }
        
        printf("Child PID: %d executing...\n", getpid());
    } else {
        // Parent process
        printf("Parent Process PID: %d, Nice Value: %d\n", getpid(), getpriority(PRIO_PROCESS, 0));
        sleep(1);
    }
    return 0;
}


Q.1: Disk Scheduling Using LOOK Algorithm
Question: Write a simulation program for disk scheduling using LOOK algorithm. Accept total number of disk blocks, disk request string, and current head position from the user. Display the list of requests in the order in which it is served. Also display the total number of head moments. Request string: 86, 147, 91, 177, 45, 12, 130 | Starting Head Position: 60 | Direction: Right.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>

void sort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] > arr[j]) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

int main() {
    int n, head;
    printf("Enter total number of requests: ");
    scanf("%d", &n);

    int req[n + 1];
    printf("Enter request string:\n");
    for (int i = 0; i < n; i++) scanf("%d", &req[i]);

    printf("Enter current head position: ");
    scanf("%d", &head);

    req[n] = head;
    n++;
    sort(req, n);

    int head_movement = 0;
    int idx = 0;
    for (int i = 0; i < n; i++) {
        if (req[i] == head) {
            idx = i;
            break;
        }
    }

    printf("\nServed Request Order: ");
    // Moving Right first (Direction: Right)
    for (int i = idx; i < n; i++) {
        printf("%d ", req[i]);
        if (i < n - 1)
            head_movement += abs(req[i] - req[i + 1]);
    }

    // Moving Left for remaining requests
    if (idx > 0) {
        head_movement += abs(req[n - 1] - req[idx - 1]);
        for (int i = idx - 1; i >= 0; i--) {
            printf("%d ", req[i]);
            if (i > 0)
                head_movement += abs(req[i] - req[i - 1]);
        }
    }

    printf("\nTotal Head Movements: %d\n", head_movement);
    return 0;
}

Q.2: Demand Paging LRU Page Replacement
Question: Write the simulation program to implement demand paging and show the page scheduling and total number of page faults according to the LRU (using counter method) page replacement algorithm. Assume the memory of n frames. Reference String: 3, 5, 7, 2, 5, 1, 2, 3, 1, 3, 5, 3, 1, 6, 2.  
C Code Implementation:

#include <stdio.h>

int main() {
    int ref[] = {3, 5, 7, 2, 5, 1, 2, 3, 1, 3, 5, 3, 1, 6, 2};
    int n = 15;
    int frames, page_faults = 0, time = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int mem[frames], counter[frames];
    for (int i = 0; i < frames; i++) {
        mem[i] = -1;
        counter[i] = 0;
    }

    printf("\nRef\tFrames\n");
    for (int i = 0; i < n; i++) {
        time++;
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (mem[j] == ref[i]) {
                found = 1;
                counter[j] = time;
                break;
            }
        }

        if (!found) {
            int pos = -1, min = time + 1;
            for (int j = 0; j < frames; j++) {
                if (mem[j] == -1) {
                    pos = j;
                    break;
                }
                if (counter[j] < min) {
                    min = counter[j];
                    pos = j;
                }
            }
            mem[pos] = ref[i];
            counter[pos] = time;
            page_faults++;
        }

        printf("%d\t", ref[i]);
        for (int j = 0; j < frames; j++) {
            if (mem[j] != -1) printf("%d ", mem[j]);
            else printf("- ");
        }
        if (!found) printf("(Fault)");
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", page_faults);
    return 0;
}

Q.1: Demand Paging MFU Page Replacement
Question: Write the simulation program for demand paging and show the page scheduling and total number of page faults according to the MFU (Most Frequently Used) page replacement algorithm. Assume the memory of n frames. Reference String: 8, 5, 7, 8, 5, 7, 2, 3, 7, 3, 5, 9, 4, 6, 2.  
C Code Implementation:
#include <stdio.h>

int main() {
    int ref[] = {8, 5, 7, 8, 5, 7, 2, 3, 7, 3, 5, 9, 4, 6, 2};
    int n = 15;
    int frames, page_faults = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int mem[frames], freq[frames];
    for (int i = 0; i < frames; i++) {
        mem[i] = -1;
        freq[i] = 0;
    }

    printf("\nRef\tFrames\n");
    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (mem[j] == ref[i]) {
                found = 1;
                freq[j]++;
                break;
            }
        }

        if (!found) {
            int pos = -1;
            // Check for empty frame first
            for (int j = 0; j < frames; j++) {
                if (mem[j] == -1) {
                    pos = j;
                    break;
                }
            }

            // If no empty frame, apply MFU (replace page with highest frequency)
            if (pos == -1) {
                int max_freq = -1;
                for (int j = 0; j < frames; j++) {
                    if (freq[j] > max_freq) {
                        max_freq = freq[j];
                        pos = j;
                    }
                }
            }

            mem[pos] = ref[i];
            freq[pos] = 1; // Reset frequency for the newly loaded page
            page_faults++;
        }

        printf("%d\t", ref[i]);
        for (int j = 0; j < frames; j++) {
            if (mem[j] != -1) printf("%d ", mem[j]);
            else printf("- ");
        }
        if (!found) printf("(Fault)");
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", page_faults);
    return 0;
}

