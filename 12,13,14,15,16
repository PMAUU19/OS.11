Q.1: FCFS CPU Scheduling Simulation
Question: Write the program to simulate FCFS CPU scheduling. The arrival time and first CPU-burst for different n number of processes should be input to the algorithm. The next CPU-burst should be generated randomly. The output should give Gantt chart, turnaround time and waiting time for each process. Also find the average waiting time and turnaround time.  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id;
    int at; // Arrival time
    int bt1; // First CPU burst
    int bt2; // Second CPU burst (randomly generated)
    int ct, tat, wt;
};

int main() {
    int n, i;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time and First CPU Burst for Process P%d: ", p[i].id);
        scanf("%d %d", &p[i].at, &p[i].bt1);
        p[i].bt2 = rand() % 10 + 1; // Random next CPU burst between 1 and 10
    }

    // Sort by arrival time
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (p[i].at > p[j].at) {
                struct Process temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    int current_time = 0;
    float total_wt = 0, total_tat = 0;

    printf("\n--- GANTT CHART ---\n|");
    for (i = 0; i < n; i++) {
        if (current_time < p[i].at)
            current_time = p[i].at;
        current_time += p[i].bt1 + p[i].bt2;
        p[i].ct = current_time;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - (p[i].bt1 + p[i].bt2);
        
        total_wt += p[i].wt;
        total_tat += p[i].tat;

        printf(" P%d |", p[i].id);
    }
    printf("\n");

    printf("\nPID\tArrival\tBurst1\tBurst2\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].bt1, p[i].bt2, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}

Q.2: Sorting Using Fork, Bubble Sort, and Insertion Sort
Question: Implement the C program to accept n integers to be sorted. Main function creates child process using fork system call. Parent process sorts the integers using bubble sort and waits for child process using wait system call child process sorts the integers using insertion sort.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

void bubbleSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void insertionSort(int arr[], int n) {
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

int main() {
    int n;
    printf("Enter number of integers: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    } else if (pid == 0) {
        // Child process
        printf("\n[Child Process] PID: %d\n", getpid());
        insertionSort(arr, n);
        printf("Sorted array using Insertion Sort: ");
        for (int i = 0; i < n; i++) printf("%d ", arr[i]);
        printf("\n");
    } else {
        // Parent process
        wait(NULL); // Wait for child to complete
        printf("\n[Parent Process] PID: %d\n", getpid());
        bubbleSort(arr, n);
        printf("Sorted array using Bubble Sort: ");
        for (int i = 0; i < n; i++) printf("%d ", arr[i]);
        printf("\n");
    }
    return 0;
}

Q.1: Non-Preemptive SJF CPU Scheduling Simulation
Question: Write the program to simulate Non-preemptive Shortest Job First (SJF) scheduling. The arrival time and first CPU burst for different n number of processes should be input to the algorithm. The next CPU-burst should be generated randomly. The output should give Gantt chart, turnaround time and waiting time for each process. Also find the average waiting time and turnaround time.  
C Code Implementation:
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id, at, bt1, bt2, total_bt, ct, tat, wt, completed;
};

int main() {
    int n, completed = 0, current_time = 0;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time and First CPU Burst for Process P%d: ", p[i].id);
        scanf("%d %d", &p[i].at, &p[i].bt1);
        p[i].bt2 = rand() % 10 + 1;
        p[i].total_bt = p[i].bt1 + p[i].bt2;
        p[i].completed = 0;
    }

    float total_wt = 0, total_tat = 0;
    printf("\n--- GANTT CHART ---\n|");

    while (completed < n) {
        int min_bt = 9999, idx = -1;
        for (int i = 0; i < n; i++) {
            if (p[i].at <= current_time && !p[i].completed && p[i].total_bt < min_bt) {
                min_bt = p[i].total_bt;
                idx = i;
            }
        }

        if (idx == -1) {
            current_time++;
        } else {
            current_time += p[idx].total_bt;
            p[idx].ct = current_time;
            p[idx].tat = p[idx].ct - p[idx].at;
            p[idx].wt = p[idx].tat - p[idx].total_bt;
            p[idx].completed = 1;
            completed++;

            total_wt += p[idx].wt;
            total_tat += p[idx].tat;
            printf(" P%d |", p[idx].id);
        }
    }
    printf("\n");

    printf("\nPID\tArrival\tTotalBurst\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].total_bt, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}

Q.2: Disk Scheduling Using LOOK Algorithm
Question: Write a simulation program for disk scheduling using LOOK algorithm. Accept total number of disk blocks, disk request string, and current head position from the user. Display the list of requests in the order in which it is served. Also display the total number of head movements. Reference requests: 15, 30, 55, 90, 125, 140, 170 | Starting Head Position: 100 | Direction: Left.  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>

void sort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] > arr[j]) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

int main() {
    int n, head, max_limit;
    printf("Enter total number of requests: ");
    scanf("%d", &n);

    int req[n + 1];
    printf("Enter request string:\n");
    for (int i = 0; i < n; i++) scanf("%d", &req[i]);

    printf("Enter current head position: ");
    scanf("%d", &head);

    req[n] = head;
    n++;
    sort(req, n);

    int head_movement = 0;
    int idx = 0;
    for (int i = 0; i < n; i++) {
        if (req[i] == head) {
            idx = i;
            break;
        }
    }

    printf("\nServed Request Order: ");
    // Moving Left first
    for (int i = idx; i >= 0; i--) {
        printf("%d ", req[i]);
        if (i > 0)
            head_movement += abs(req[i] - req[i - 1]);
    }

    // Moving Right for remaining requests
    if (idx < n - 1) {
        head_movement += abs(req[0] - req[idx + 1]);
        for (int i = idx + 1; i < n; i++) {
            printf("%d ", req[i]);
            if (i < n - 1)
                head_movement += abs(req[i] - req[i + 1]);
        }
    }

    printf("\nTotal Head Movements: %d\n", head_movement);
    return 0;
}

Q.1: Array Sorting and Binary Search via execve()
Question: Implement the C program that accepts an integer array. Main function forks child process. Parent process sorts an integer array and passes the sorted array to child process through the command line arguments of execve() system call. The child process uses execve() system call to load new program that uses this sorted array for performing the binary search the particular item in the array. 
 
Parent Program (parent.c):

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int n;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);

    // Sort array in parent using Bubble Sort
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    char *args[n + 3];
    args[0] = "./child";
    for (int i = 0; i < n; i++) {
        args[i + 1] = malloc(10);
        sprintf(args[i + 1], "%d", arr[i]);
    }
    args[n + 1] = NULL;

    pid_t pid = fork();
    if (pid == 0) {
        execve("./child", args, NULL);
        perror("Execve failed");
        exit(1);
    } else {
        wait(NULL);
    }
    return 0;
}

Child program 
#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
    int n = argc - 1;
    int arr[n];
    for (int i = 0; i < n; i++) arr[i] = atoi(argv[i + 1]);

    int key;
    printf("\n[Child Program] Enter element to search using Binary Search: ");
    scanf("%d", &key);

    int low = 0, high = n - 1, found = 0;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] == key) {
            printf("Element %d found at index %d!\n", key, mid);
            found = 1;
            break;
        } else if (arr[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    if (!found) printf("Element not found in the array.\n");
    return 0;
}

Q.2: Demand Paging FIFO Page Replacement
Question: Write the simulation program for demand paging and show the page scheduling and total number of page faults according to the FIFO page replacement algorithm. Assume the memory of n frames. Reference String: 3, 4, 5, 6, 3, 4, 7, 3, 4, 5, 6, 7, 2, 4, 6.  
C Code Implementation:

#include <stdio.h>

int main() {
    int ref[] = {3, 4, 5, 6, 3, 4, 7, 3, 4, 5, 6, 7, 2, 4, 6};
    int n = 15;
    int frames, page_faults = 0, k = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int mem[frames];
    for (int i = 0; i < frames; i++) mem[i] = -1;

    printf("\nRef\tFrames\n");
    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (mem[j] == ref[i]) {
                found = 1;
                break;
            }
        }

        if (!found) {
            mem[k] = ref[i];
            k = (k + 1) % frames;
            page_faults++;
        }

        printf("%d\t", ref[i]);
        for (int j = 0; j < frames; j++) {
            if (mem[j] != -1) printf("%d ", mem[j]);
            else printf("- ");
        }
        if (!found) printf("(Fault)");
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", page_faults);
    return 0;
}

Q.1: Orphan Process Illustration
Question: Write a C program to illustrate the concept of orphan process. Parent process creates a child process and terminates before child has finished its task. So child process becomes orphan process. (Use fork(), sleep(), getpid(), getppid).  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    } else if (pid == 0) {
        // Child process
        printf("Child Process created. PID: %d, Initial Parent PID: %d\n", getpid(), getppid());
        sleep(5); // Sleep to let parent terminate first
        printf("Child Process resumed. PID: %d, New Parent PID: %d (Adopted by init/systemd)\n", getpid(), getppid());
    } else {
        // Parent process terminates immediately
        printf("Parent Process (PID: %d) terminating...\n", getpid());
        exit(0);
    }
    return 0;
}

Q.2: Preemptive Priority CPU Scheduling Simulation
Question: Write the program to simulate Preemptive Priority scheduling. The arrival time and first CPU-burst and priority for different n number of processes should be input to the algorithm. The next CPU-burst should be generated randomly. The output should give Gantt chart, turnaround time and waiting time for each process. Also find the average waiting time and turnaround time.  
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process {
    int id, at, bt1, bt2, total_bt, priority, rt, ct, tat, wt;
};

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[10];
    srand(time(0));

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("Enter Arrival Time, First CPU Burst, and Priority for P%d: ", p[i].id);
        scanf("%d %d %d", &p[i].at, &p[i].bt1, &p[i].priority);
        p[i].bt2 = rand() % 10 + 1;
        p[i].total_bt = p[i].bt1 + p[i].bt2;
        p[i].rt = p[i].total_bt;
    }

    int completed = 0, current_time = 0;
    float total_wt = 0, total_tat = 0;

    while (completed < n) {
        int highest_priority = 9999, idx = -1;
        for (int i = 0; i < n; i++) {
            if (p[i].at <= current_time && p[i].rt > 0 && p[i].priority < highest_priority) {
                highest_priority = p[i].priority;
                idx = i;
            }
        }

        if (idx == -1) {
            current_time++;
        } else {
            p[idx].rt--;
            current_time++;
            if (p[idx].rt == 0) {
                completed++;
                p[idx].ct = current_time;
                p[idx].tat = p[idx].ct - p[idx].at;
                p[idx].wt = p[idx].tat - p[idx].total_bt;
                total_wt += p[idx].wt;
                total_tat += p[idx].tat;
            }
        }
    }

    printf("\nPID\tArrival\tBurst\tPriority\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].total_bt, p[i].priority, p[i].ct, p[i].tat, p[i].wt);
    }

    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    return 0;
}

Q.1: Demand Paging LRU Page Replacement
Question: Write the simulation program to implement demand paging and show the page scheduling and total number of page faults according to the LRU (using counter method) page replacement algorithm. Assume the memory of n frames. Reference String : 3, 5, 7, 2, 5, 1, 2, 3, 1, 3, 5, 3, 1, 6, 2.  
C Code Implementation:

#include <stdio.h>

int main() {
    int ref[] = {3, 5, 7, 2, 5, 1, 2, 3, 1, 3, 5, 3, 1, 6, 2};
    int n = 15;
    int frames, page_faults = 0, time = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int mem[frames], counter[frames];
    for (int i = 0; i < frames; i++) {
        mem[i] = -1;
        counter[i] = 0;
    }

    printf("\nRef\tFrames\n");
    for (int i = 0; i < n; i++) {
        time++;
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (mem[j] == ref[i]) {
                found = 1;
                counter[j] = time;
                break;
            }
        }

        if (!found) {
            int pos = -1, min = time + 1;
            for (int j = 0; j < frames; j++) {
                if (mem[j] == -1) {
                    pos = j;
                    break;
                }
                if (counter[j] < min) {
                    min = counter[j];
                    pos = j;
                }
            }
            mem[pos] = ref[i];
            counter[pos] = time;
            page_faults++;
        }

        printf("%d\t", ref[i]);
        for (int j = 0; j < frames; j++) {
            if (mem[j] != -1) printf("%d ", mem[j]);
            else printf("- ");
        }
        if (!found) printf("(Fault)");
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", page_faults);
    return 0;
}


Q.2: Custom Shell Implementation with 'count' Command
Question: Write a C program that behaves like a shell which displays the command prompt ‘$’. It accepts the command, tokenize the command line and execute it by creating the child process. Also implement the additional command ‘count’:  
$ count c filename (displays character count)
$ count w filename (displays word count)
$ count l filename (displays line count)
C Code Implementation:

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

void countCommand(char type, char *filename) {
    FILE *fp = fopen(filename, "r");
    if (!fp) {
        perror("File opening failed");
        return;
    }

    int chars = 0, words = 0, lines = 0;
    char ch;
    int in_word = 0;

    while ((ch = fgetc(fp)) != EOF) {
        chars++;
        if (ch == '\n') lines++;
        if (ch == ' ' || ch == '\t' || ch == '\n') {
            in_word = 0;
        } else if (!in_word) {
            in_word = 1;
            words++;
        }
    }
    fclose(fp);

    if (type == 'c') printf("Total Characters: %d\n", chars);
    else if (type == 'w') printf("Total Words: %d\n", words);
    else if (type == 'l') printf("Total Lines: %d\n", lines);
    else printf("Invalid count option! Use c, w, or l.\n");
}

int main() {
    char cmd[100];
    while (1) {
        printf("$ ");
        fgets(cmd, sizeof(cmd), stdin);
        cmd[strcspn(cmd, "\n")] = 0; // Remove trailing newline

        if (strcmp(cmd, "exit") == 0) break;

        char *args[10];
        int i = 0;
        char *token = strtok(cmd, " ");
        while (token != NULL) {
            args[i++] = token;
            token = strtok(NULL, " ");
        }
        args[i] = NULL;

        if (args[0] == NULL) continue;

        if (strcmp(args[0], "count") == 0) {
            if (args[1] && args[2]) {
                countCommand(args[1][0], args[2]);
            } else {
                printf("Usage: count <c/w/l> <filename>\n");
            }
        } else {
            pid_t pid = fork();
            if (pid == 0) {
                execvp(args[0], args);
                perror("Command execution failed");
                exit(1);
            } else {
                wait(NULL);
            }
        }
    }
    return 0;
}

